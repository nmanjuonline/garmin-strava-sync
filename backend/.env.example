# Garmin Connect login (unofficial API — your normal Garmin Connect credentials)
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your-garmin-password

# Strava API app credentials (create at https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=123456
STRAVA_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# One-time refresh token obtained via the OAuth flow — see README "Strava setup"
STRAVA_REFRESH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: map Garmin gear display names to Strava gear IDs (JSON string).
# Get Strava gear IDs from GET /api/strava/gear once the server is running.
GEAR_MAP_JSON={"Nike Pegasus 40":"g12345678","Trek Domane":"b12345678"}

# Optional: how close (in minutes) a Garmin/Strava activity start time must be
# to count as the same activity. Default 10.
MATCH_TOLERANCE_MINUTES=10
